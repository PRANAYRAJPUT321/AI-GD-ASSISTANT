# GD Arena environment variables. Copy to .env.local for local development
# (or set them in your Vercel project settings) and fill in what you need.
# One AI key is required (Claude, Gemini or Groq); everything else has a working default.

# ---------- AI provider ----------

# Which AI service runs the participants and the scoring: claude | gemini | groq | openai.
# Default: the first one below that has a key set (Claude, then Gemini, then Groq).
GD_PROVIDER=

# Claude (Anthropic API). Best quality; the account needs prepaid credits.
# (A variable named pranay_api_key is also accepted, as a fallback.)
ANTHROPIC_API_KEY=

# Google Gemini API key (free tier available): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq API key (free plan available): https://console.groq.com/keys
GROQ_API_KEY=

# Any other OpenAI-compatible endpoint (GD_PROVIDER=openai): base URL + key; set GD_MODEL too.
# LLM_BASE_URL also overrides the Gemini/Groq endpoint if set.
LLM_BASE_URL=
LLM_API_KEY=

# Model for the five AI participants' lines. For Gemini/Groq/OpenAI-compatible APIs this can be a
# comma-separated list, tried in order (a model that is missing or out of quota hands over to the next).
# Default: claude-opus-5-5 (claude); gemini-flash-lite-latest, gemini-flash-latest,
# gemini-2.5-flash-lite, gemini-2.5-flash (gemini); openai/gpt-oss-120b (groq).
GD_MODEL=

# Model (or list) for the end-of-GD scorecard. Default: claude-opus-5-5 for Claude; Gemini starts
# with gemini-flash-latest; otherwise the GD_MODEL list.
GD_SCORING_MODEL=

# Claude only. Effort for participant lines: low | medium | high | xhigh | max. Default: low
# (short spoken lines; higher effort is slower and costs more per turn).
GD_TURN_EFFORT=

# ---------- Session tokens ----------

# HMAC secret that signs the per-GD session tokens. Use a long random string,
# e.g. `openssl rand -base64 32`. Default: derived from the configured AI key
# (sha256("gd-arena:" + key)), so rotating the key also invalidates open sessions.
SESSION_SECRET=

# ---------- Daily limits (cost control) ----------

# GDs per device per day (device = random id in the httpOnly gd_device cookie).
# Default: 3. 0 = unlimited (the setup screen then shows no limit).
DAILY_GD_LIMIT=3

# GDs per IP address per day. Looser than the device limit so a whole campus
# behind one NAT still works. Default: 30. 0 = off.
DAILY_GD_LIMIT_PER_IP=30

# GDs per day across everyone: a hard daily budget cap. Default: 0 = off.
DAILY_GD_LIMIT_GLOBAL=0

# IANA timezone in which the daily limits roll over at midnight. Default: Asia/Kolkata
LIMIT_TIMEZONE=Asia/Kolkata

# ---------- Counter store ----------

# Upstash Redis REST credentials for the limit counters. Recommended in production:
# without them counts are kept in memory per server instance, which is exact for
# local dev but only approximate on Vercel (each warm instance counts separately).
# Default: unset (in-memory).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel KV / Upstash-for-Vercel integration names for the same thing. Used when
# the UPSTASH_* variables are not set. Default: unset.
KV_REST_API_URL=
KV_REST_API_TOKEN=
